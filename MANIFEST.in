include LICENSE NOTICE THIRD_PARTY_NOTICES AUTHORS.md CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md *.json *.txt *.html *.rst *LICENSE* *COPYING* *NOTICE*
recursive-include data *.json
recursive-include schemas *.json
recursive-include examples *.json
recursive-include requirements *.lock
recursive-include tests *.py *.bsp *.json *.md
recursive-include tools *.py
recursive-include benchmarks *.py
recursive-include src *.py *.typed *.json *.dat
prune .artifacts
